# ── Telegram ────────────────────────────────────────────
BOT_TOKEN=1234567890:AA...your-bot-token-from-botfather
ADMIN_ID=123456789

# ── ЮKassa: АВТООПЛАТА через Telegram Payments ─────────
# @BotFather → /mybots → ваш бот → Payments → ЮKassa → подключить магазин.
# BotFather выдаст токен вида 390540012:LIVE:xxxx (для теста — ...:TEST:...).
# Если токен задан — кнопки /buy выставляют счёт в Telegram, и доступ
# выдаётся автоматически. Если пусто — работают ссылки ниже + ручной /give_access.
PAYMENT_PROVIDER_TOKEN=
PRICE_MONTH_RUB=1490
PRICE_FOREVER_RUB=5000
# 1 = передавать чек в ЮKassa (нужно, если подключены «Чеки от ЮKassa» / онлайн-касса)
YOOKASSA_SEND_RECEIPT=0
# Код НДС для чека: 1 = без НДС (УСН/самозанятый), 4 = 20% и т.д.
YOOKASSA_VAT_CODE=1

# ── Запасной вариант оплаты (ручная выдача) ─────────────
PAYMENT_URL_MONTH=https://yookassa.ru/checkout/payments/v2/contract?orderId=...
PAYMENT_URL_FOREVER=https://yookassa.ru/checkout/payments/v2/contract?orderId=...
CARD_DETAILS=Тинькофф 2200 1234 5678 9012 (Александр П.)

# ── AI (хотя бы один ключ) ──────────────────────────────
# CLODEX — основной агрегатор (OpenAI-compatible base_url: https://clodex.xyz/v1)
# Ключ формата: sk-... (без префикса sk-or-v1-!)
CLODEX_API_KEY=sk-...

# OpenRouter — альтернативный агрегатор (https://openrouter.ai/api/v1)
# Используется если CLODEX недоступен. Ключ формата sk-or-v1-...
OPENROUTER_API_KEY=sk-or-v1-...

# Прямой OpenAI (если хотите минуя агрегаторы)
OPENAI_API_KEY=sk-proj-...

# Yandex Cloud YandexGPT — оплата в рублях
YANDEX_API_KEY=AQVN...
YANDEX_FOLDER_ID=b1g...

# GigaChat (Сбер) — рубли, без санкционных рисков
GIGACHAT_CREDENTIALS=...

# ── Какие модели для каких задач ──────────────────────
# Формат: "провайдер:модель"
#   clodex     = clodex.xyz (рекомендую — самые выгодные цены)
#   openrouter = OpenRouter
#   openai     = прямой OpenAI API
#   yandex     = YandexGPT
#   gigachat   = GigaChat

# Tier 1: дешёвые и быстрые для саммари (90% запросов)
# gpt-5.6-terra — быстрая GPT через OpenAI-стиль ($0.07/1M)
AI_TIER1=clodex:gpt-5.6-terra

# Tier 2: AI-чат и сравнения (9% запросов)
# gemini-3.7-flash — хороший баланс качества для русского ($0.15/1M)
AI_TIER2=clodex:gemini-3.7-flash

# Tier 3: премиум для сложных кейсов (1% запросов)
# gpt-6-astra — топ-модель clodex ($0.5/1M)
AI_TIER3=clodex:gpt-6-astra
